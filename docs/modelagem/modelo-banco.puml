@startuml

title Modelo de Banco de Dados - Livro+

entity Usuario {
  * id : INTEGER <<PK>>
  --
  nome : VARCHAR
  email : VARCHAR <<UNIQUE>>
  senha : VARCHAR
  tipo : VARCHAR
}

entity Livro {
  * id : INTEGER <<PK>>
  --
  titulo : VARCHAR
  autor : VARCHAR
  isbn : VARCHAR
  capa_url : VARCHAR
  descricao : TEXT
  ano_publicacao : INTEGER
  quantidade : INTEGER
  disponivel : INTEGER
}

entity Emprestimo {
  * id : INTEGER <<PK>>
  --
  usuario_id : INTEGER <<FK>>
  livro_id : INTEGER <<FK>>
  data_emprestimo : DATE
  data_devolucao_prevista : DATE
  data_devolucao : DATE
  status : VARCHAR
}

entity Avaliacao {
  * id : INTEGER <<PK>>
  --
  usuario_id : INTEGER <<FK>>
  livro_id : INTEGER <<FK>>
  nota : INTEGER
  comentario : TEXT
  data_avaliacao : DATE
}

entity Leitura {
  * id : INTEGER <<PK>>
  --
  usuario_id : INTEGER <<FK>>
  livro_id : INTEGER <<FK>>
  status : VARCHAR
  data_inicio : DATE
  data_fim : DATE
}

Usuario ||--o{ Emprestimo : realiza
Livro ||--o{ Emprestimo : possui

Usuario ||--o{ Avaliacao : registra
Livro ||--o{ Avaliacao : recebe

Usuario ||--o{ Leitura : acompanha
Livro ||--o{ Leitura : possui

@enduml
